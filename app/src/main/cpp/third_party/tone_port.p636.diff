+
+void store7(uint8_t* p, uint64_t value) {
+    const auto low = static_cast<uint32_t>(value), high = static_cast<uint32_t>(value >> 24);
+    std::memcpy(p, &low, 4);
+    std::memcpy(p + 3, &high, 4);
