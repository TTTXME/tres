+    const auto* a = bright.data + size_t(y) * bright.row_stride;
+    const auto* b = dark.data + size_t(y) * dark.row_stride;
+    for (int x = 0; x < width; ++x, a += 3, b += 3, out += 7) {
+        out[0] = a[0];
+        out[1] = a[1];
+        out[2] = a[2];
+        out[3] = b[0];
+        out[4] = b[1];
