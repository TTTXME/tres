+        for (int y = static_cast<int>(first); y < static_cast<int>(last); ++y) {
+            const uint8_t* rows[4];
+            for (int j = 0; j < 4; ++j) rows[j] = parent.pixel(0, border(2 * y + j - 1, height, mirror)).data();
+            downsample_row(rows, width, mirror, next, y);
+        }
+    });
