<?xml version="1.0" encoding="utf-8"?>
<!--
  SCAMERA: the camera (a launcher entry of its own), its settings and helper screens, the gallery (a second launcher entry, the
  photo viewer / picker / editor other apps call), and the services that keep a shot's processing and the vivo SDK lease alive.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- androidx.heifwriter declares minSdk 28: HEIC output is offered and used only on API 28+ (PhotoFormat). -->
    <uses-sdk
        tools:overrideLibrary="androidx.heifwriter" />

    <!-- ── what the camera needs: the camera, the gyro at full rate (shake gating), the microphone (video) ── -->
    <uses-permission
        android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"
        tools:ignore="HighSamplingRate" />
    <uses-permission
        android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="true"
        tools:ignore="UnnecessaryRequiredFeature" />
    <uses-feature
        android:name="android.hardware.camera.capability.raw" />

    <!-- ── storage. Read for the gallery (system camera images too); written through SAF on Android 11+. ── -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 10 writes the photos straight into DCIM: that needs the legacy storage mode (requestLegacyExternalStorage
         below; ignored from Android 11 on). Without it every save failed with ImageSavingError (Nubia NX563J, Android 10). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- P475: «Доступ ко всем файлам» (Android 11+): scam_dev.txt and the other Download/SCAMERA files a PC, adb or an earlier
         package made (AllFilesAccess asks once at the first launch) -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- ── work behind the screen. P92: a shot's processing runs on as a foreground service (its notification); the video
         player's playback service. ── -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".app.ScameraApp"
        android:label="@string/app_name"
        android:icon="@mipmap/scamera_launcher"
        android:roundIcon="@mipmap/scamera_launcher_round"
        android:theme="@style/Theme.Scamera.BaseApp"
        android:launchMode="singleTask"
        android:taskAffinity=""
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        tools:targetApi="q">

        <!-- ════ the camera ════ -->
        <activity
            android:name=".ui.SplashActivity"
            android:theme="@style/Theme.Scamera.Splash"
            android:exported="true">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- other apps' «open the camera». No IMAGE_CAPTURE / STILL_IMAGE_CAMERA_SECURE: the camera has no
                 capture-for-result mode (EXTRA_OUTPUT, setResult) and no lock-screen mode, so the calling app got
                 RESULT_CANCELED at once. Only with such a mode. -->
            <intent-filter>
                <action
                    android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <category
                    android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- P140: long press on the launcher icon -> «Настройки» -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <activity
            android:name=".ui.camera.CameraActivity"
            android:configChanges="orientation|keyboardHidden|screenSize" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:theme="@style/Theme.Scamera.SettingsActivity" />
        <activity
            android:name=".ui.camera.LensDiscoveryActivity"
            android:label="@string/lens_discovery_title"
            android:theme="@style/Theme.Scamera.SettingsActivity" />
        <activity
            android:name=".ui.settings.ScamActivity"
            android:exported="false"
            android:process=":scam"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- ════ the gallery ════ -->
        <activity
            android:name="com.scamera.app.gallery.ui.GalleryActivity"
            android:label="@string/gallery_name"
            android:icon="@mipmap/ic_gallery_launcher"
            android:roundIcon="@mipmap/ic_gallery_launcher_round"
            android:theme="@style/Theme.Scamera.BaseApp"
            android:taskAffinity=""
            android:finishOnTaskLaunch="true"
            android:exported="true">
            <!-- REVIEW: what a camera app sends to show the photo it took; P621: videos too (the gallery's player), and
                 MediaStore.ACTION_REVIEW / ACTION_REVIEW_SECURE (the secure one: that item alone over the lock screen).
                 The <data> of a filter combine: file and content URIs of images and videos. -->
            <intent-filter>
                <action
                    android:name="com.android.camera.action.REVIEW" />
                <action
                    android:name="android.provider.action.REVIEW" />
                <action
                    android:name="android.provider.action.REVIEW_SECURE" />
                <data
                    android:scheme="file"
                    android:mimeType="image/*" />
                <data
                    android:scheme="content"
                    android:mimeType="video/*" />
                <category
                    android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- VIEW of a photo from another app; P621: a video too (played by the gallery's player) -->
            <intent-filter>
                <action
                    android:name="android.intent.action.VIEW" />
                <data
                    android:scheme="file"
                    android:mimeType="image/*" />
                <data
                    android:scheme="content"
                    android:mimeType="video/*" />
                <category
                    android:name="android.intent.category.DEFAULT" />
                <category
                    android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
            <!-- VIEW of a folder of photos: the gallery app itself -->
            <intent-filter>
                <action
                    android:name="android.intent.action.VIEW" />
                <data
                    android:mimeType="vnd.android.cursor.dir/image" />
                <category
                    android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- P621: PICK / GET_CONTENT of a photo or a video: the library opens, a tap returns that item (one; the grid's
                 type and the asked type must agree). Not MediaStore.ACTION_PICK_IMAGES: that is the system photo picker's
                 contract (several items, its extras), which this single pick does not keep. -->
            <intent-filter>
                <action
                    android:name="android.intent.action.PICK" />
                <data
                    android:mimeType="image/*" />
                <data
                    android:mimeType="video/*" />
                <data
                    android:mimeType="vnd.android.cursor.dir/image" />
                <data
                    android:mimeType="vnd.android.cursor.dir/video" />
                <category
                    android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action
                    android:name="android.intent.action.GET_CONTENT" />
                <data
                    android:mimeType="image/*" />
                <data
                    android:mimeType="video/*" />
                <category
                    android:name="android.intent.category.DEFAULT" />
                <category
                    android:name="android.intent.category.OPENABLE" />
            </intent-filter>
            <!-- P351: other apps can edit a photo in the gallery's editor (the copy's URI comes back with RESULT_OK) -->
            <intent-filter>
                <action
                    android:name="android.intent.action.EDIT" />
                <data
                    android:scheme="file"
                    android:mimeType="image/*" />
                <data
                    android:scheme="content" />
                <category
                    android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- P352: camera RAWs that file managers send as application/octet-stream (or with no type) are recognised by their
                 extension; other binary files are not claimed. image/x-* RAW types are image/* above. -->
            <intent-filter>
                <action
                    android:name="android.intent.action.VIEW" />
