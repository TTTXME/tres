                <data android:pathPattern=".*\..*\.MOS" />
                <category
                    android:name="android.intent.category.DEFAULT" />
                <category
                    android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
            <intent-filter>
                <action
                    android:name="android.intent.action.VIEW" />
                <data
                    android:scheme="file"
                    android:host="*" />
                <data android:pathPattern=".*\.dng" />
                <data android:pathPattern=".*\..*\.dng" />
