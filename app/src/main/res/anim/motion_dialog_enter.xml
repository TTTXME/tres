<?xml version="1.0" encoding="utf-8"?>
<!-- P572: an iOS alert - the dialog comes in from 108 % to its size and fades in. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/motion_ease_out"
    android:shareInterpolator="true">
    <scale android:duration="300" android:fromXScale="1.08" android:toXScale="1" android:fromYScale="1.08" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:duration="200" android:fromAlpha="0" android:toAlpha="1" />
</set>
