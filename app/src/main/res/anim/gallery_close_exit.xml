<?xml version="1.0" encoding="utf-8"?>
<!-- P498: the photo folds back (ImageViewerFragment shrinks it into its cell; this is the plain fallback). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
        android:duration="300"
        android:interpolator="@interpolator/motion_sheet"
        android:zAdjustment="top">
    <scale android:fromXScale="1" android:toXScale="0.88" android:fromYScale="1" android:toYScale="0.88"
            android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="1" android:toAlpha="0" />
</set>
