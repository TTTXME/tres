<?xml version="1.0" encoding="utf-8"?>
<!-- P495: iOS push - the camera moves a third to the left and dims under the new screen. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
        android:duration="380"
        android:interpolator="@interpolator/motion_sheet"
        android:zAdjustment="normal">
    <translate android:fromXDelta="0" android:toXDelta="-30%" />
    <alpha android:fromAlpha="1" android:toAlpha="0.6" />
</set>
