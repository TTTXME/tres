    <string name="prefs_scam_motion_on_title">Sport mode</string>
    <string name="prefs_scam_motion_on_summary">A short shutter and a fast frame buffer for moving subjects: children, animals, sport. In low light the noise reduction is stronger.</string>
    <string name="prefs_scam_motion_screen_title">Sport</string>
    <string name="prefs_scam_motion_screen_summary">The values of Sport mode (the button in the top bar): shutter and frame count for crisp moving subjects.</string>
    <string name="prefs_scam_motion_shutter_title">Shutter at most</string>
    <string name="prefs_scam_motion_shutter_summary">The longest shutter in Sport mode. Shorter: crisper motion but a noisier shot, as the camera raises ISO.</string>
    <string name="prefs_scam_motion_flicker_title">No lamp flicker</string>
    <string name="prefs_scam_motion_flicker_summary">Under flickering lamps the shutter follows their cycle (no shorter than 1/100 or 1/120 s): no flicker or bands, but motion is a little more blurred.</string>
    <string name="prefs_scam_motion_frames_title">Frames to merge</string>
    <string name="prefs_scam_motion_frames_summary">How many frames to merge in Sport mode. Higher: less noise but slower. Lower: faster.</string>
    <string name="prefs_scam_motion_shasta_summary">Whether long frames for the shadows are taken in Sport mode.</string>
    <string name="prefs_scam_motion_bento_summary">Whether short frames for the highlights are taken in Sport mode.</string>
    <string name="prefs_scam_motion_boost_summary">In Sport mode removes doubled outlines harder where parts of the frame move differently.</string>
    <string name="prefs_scam_motion_boost_value_summary">Higher: fewer doubled outlines but a noisier shot. Lower: the other way round.</string>
    <string name="prefs_scam_motion_threshold_summary">From which shift, in sensor pixels, an area counts as moving. Lower: less doubling. Higher: less noise.</string>
    <string name="prefs_low_light_boost_title">Night viewfinder</string>
    <string name="prefs_low_light_boost_summary">In the dark the viewfinder gets brighter, but updates less often and the frames for the shot get longer. Needs Android 15; does not work in Sport mode.</string>
