<?xml version="1.0" encoding="utf-8"?>
<!-- A preference drawing its own card (the tone curve, the crop picture, a tile): P574 the rows' card - #2C2C2E, no outline,
     24dp corners (was the bluish card with an outline); ripple on press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1FFFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_row_card"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</ripple>
