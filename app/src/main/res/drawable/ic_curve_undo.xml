<?xml version="1.0" encoding="utf-8"?>
<!-- P570: generated by tools/icons/build.mjs from undo (Kubai Icons shapes, one-colour line style), accent #0A84FF: the rest pose, the pressed / activated pose and the motion between them (460 ms) -->
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/kb_pressed" android:state_pressed="true" android:drawable="@drawable/kb_ic_curve_undo_hover" />
    <item android:id="@+id/kb_activated" android:state_activated="true" android:drawable="@drawable/kb_ic_curve_undo_hover" />
    <item android:id="@+id/kb_rest" android:drawable="@drawable/kb_ic_curve_undo_rest" />
    <transition android:fromId="@id/kb_rest" android:toId="@id/kb_pressed" android:drawable="@drawable/kb_ic_curve_undo_in" />
    <transition android:fromId="@id/kb_pressed" android:toId="@id/kb_rest" android:drawable="@drawable/kb_ic_curve_undo_out" />
    <transition android:fromId="@id/kb_rest" android:toId="@id/kb_activated" android:drawable="@drawable/kb_ic_curve_undo_in" />
    <transition android:fromId="@id/kb_activated" android:toId="@id/kb_rest" android:drawable="@drawable/kb_ic_curve_undo_out" />
</animated-selector>
