<?xml version="1.0" encoding="utf-8"?>
<!-- P574: a row's icon tile - 32dp, 9dp corners; SettingsStyle.bind fills it with the dark tone of the icon's hue (SettingsTiles)
     and draws the icon in its light tone; this grey is the tile of a row without a known hue. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FF45464B"/>
    <corners android:radius="9dp"/>
</shape>
