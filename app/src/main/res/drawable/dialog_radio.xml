<?xml version="1.0" encoding="utf-8"?>
<!-- The mark of a dialog's single-choice list: P574 the settings' tick (SettingsStyle.radio) - an accent tick when chosen,
     nothing otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:drawable="@drawable/dialog_radio_on" />
    <item android:drawable="@drawable/dialog_radio_off" />
</selector>
