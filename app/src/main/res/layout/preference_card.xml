<?xml version="1.0" encoding="utf-8"?>
<!-- P574 (owner, 2026-11-09: the settings in the look of the camera's sheets): a row of a group card (SettingsCardDecoration draws
     the #2C2C2E card and the 0.5dp hairlines) - a 32dp tonal icon tile, the title (16sp, semibold, white), its description (13sp,
     white 60 %, at most three lines: SettingsStyle.fitLines), the value on the right (15sp, white 55 %) and the trailing widget
     (chevron, up / down chevron of a list, switch). P248: a value too long for the right (SettingsStyle.valueBelow) is shown under
     the title instead (settings_value_below). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_row"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="9dp"
    android:paddingEnd="16dp"
    android:paddingBottom="9dp">
    <FrameLayout
        android:id="@+id/settings_icon_tile"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/settings_icon_tile">
        <ImageView
            android:id="@android:id/icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/settings_row_title"
            android:textFontWeight="600"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/settings_value_below"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/settings_row_value"
            android:textSize="15sp"
            android:visibility="gone" />
        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/settings_summary"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/settings_restart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="7dp"
            android:paddingTop="1dp"
            android:paddingEnd="7dp"
            android:paddingBottom="1dp"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:id="@+id/settings_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="end"
        android:maxWidth="140dp"
        android:maxLines="2"
        android:textColor="@color/settings_row_value"
        android:textSize="15sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minWidth="9dp"
        android:orientation="vertical"
        android:paddingStart="10dp" />
</LinearLayout>
