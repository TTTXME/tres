<?xml version="1.0" encoding="utf-8"?>
<!-- P574 (owner, 2026-11-09: the concept's slider rows): a row of its group card - the tonal icon tile, the title and its
     description, the value in an accent pill on the title line (tap: exact input; it lifts while the knob is held and pops on
     release), then the slider (IosSlider) between its minimum and maximum, indented under the title when the row has a tile
     (SettingsStyle.bind). The knob under the finger and the rubber band reach past the slider: no view up to the row clips. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_row"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="9dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="34dp"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/settings_icon_tile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/settings_icon_tile">
            <ImageView
                android:id="@android:id/icon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@android:id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_flex_600"
            app:fontFamily="@font/roboto_flex_600"
                android:textColor="@color/settings_row_title"
                android:textSize="16dp"
            android:lineHeight="21dp"
            android:includeFontPadding="false" />
            <TextView
                android:fontFamily="@font/roboto_flex_400"
            app:fontFamily="@font/roboto_flex_400"
                android:id="@android:id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineHeight="17dp"
            android:includeFontPadding="false"
                android:textColor="@color/settings_summary"
                android:textSize="13dp" />
            <TextView
                android:fontFamily="@font/roboto_flex_400"
            app:fontFamily="@font/roboto_flex_400"
                android:id="@+id/settings_restart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="7dp"
                android:paddingTop="1dp"
                android:paddingEnd="7dp"
                android:paddingBottom="1dp"
                android:textSize="11dp"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:fontFamily="@font/roboto_flex_700"
            app:fontFamily="@font/roboto_flex_700"
            android:id="@+id/seekbar_value"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/settings_value_pill"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minWidth="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="15dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/seekbar_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="44dp">
        <TextView
            android:fontFamily="@font/roboto_flex_400"
            app:fontFamily="@font/roboto_flex_400"
            android:id="@+id/seekbar_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:maxLines="1"
            android:minWidth="18dp"
            android:textColor="@color/settings_range"
            android:textSize="12dp" />
        <com.scamera.app.ui.controls.IosSlider
            android:id="@+id/seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <TextView
            android:fontFamily="@font/roboto_flex_400"
            app:fontFamily="@font/roboto_flex_400"
            android:id="@+id/seekbar_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:minWidth="18dp"
            android:textColor="@color/settings_range"
            android:textSize="12dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
