<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        >

    <data>
        <variable
                name="bottom_bar_click_listener"
                type="android.view.View.OnClickListener"/>

        <variable
                name="uimodel"
                type="com.particlesdevs.photoncamera.ui.camera.model.CameraFragmentModel"/>

        <variable
                name="timermodel"
                type="com.particlesdevs.photoncamera.ui.camera.model.TimerFrameCountModel"/>

    </data>

    <!-- P25 shutter row, three columns: the gallery card on the left, the shutter exactly in the centre, the front /
         back switch on the right (where «Фото | Ночь» was; Night is gone). The side items stay inside their halves.
         P574 (the approved concept, as the reference app): under it the bottom row - the gear (all settings), the Sport | Photo
         switch (icons in a capsule) in the middle, «Про» (the manual controls) at the end. -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            >

        <FrameLayout
                android:id="@+id/galery_button_container"
                android:layout_width="@dimen/vf_side_button_size"
                android:layout_height="@dimen/vf_side_button_size"
                android:background="@drawable/shade_gallery_card"
                android:layout_marginStart="52dp"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/shutter_button_container"
                app:layout_constraintTop_toTopOf="@id/shutter_button_container"
                app:layout_constraintBottom_toBottomOf="@id/shutter_button_container">

            <!-- Shown until the first thumbnail: the gallery icon in the accent. -->
            <ImageView
                    android:id="@+id/gallery_placeholder"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shade_jpeg"
                    android:importantForAccessibility="no"/>

            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/gallery_image_button"
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="0dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/shade_gallery"
                    android:onClick="@{bottom_bar_click_listener}"
                    imageFromBitmap="@{uimodel.bitmap}"
                    bindRotate="@{uimodel}"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Scamera.Thumb"
                    />

            <!-- P158: the shot's processing runs round the card's edge in the accent (as in WhyCam). -->
            <com.particlesdevs.photoncamera.ui.camera.views.ProcessingRing
                    android:id="@+id/processing_progress_bar"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    />
        </FrameLayout>

        <!-- The shutter: a ring with a filled centre (P25 concept); the state drawable comes from CameraUIViewImpl. -->
        <FrameLayout
                android:layout_width="@dimen/vf_shutter_size"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1.0"
                android:id="@+id/shutter_button_container"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="1.0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/bottom_row"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >

            <ImageButton
                    android:id="@+id/shutter_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/roundbutton"
                    android:backgroundTint="@null"
                    android:clickable="true"
                    android:contentDescription="@string/shade_shutter"
                    android:onClick="@{bottom_bar_click_listener}"
                    android:textAppearance="@style/TextAppearance.AppCompat"
                    android:visibility="visible"
                    tools:text="Shot"/>

            <TextView
                    android:id="@+id/frameCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="25"
                    android:text="@{timermodel.frameCount}"
                    android:textColor="#303438"
                    android:textSize="22sp"
                    android:textAlignment="center"
                    android:typeface="normal"
                    android:visibility="gone"
                    android:layout_gravity="center"/>
        </FrameLayout>

        <!-- SIMPLE_UI §1: a long burst's remaining time, a small line under the shutter (no frame count in the shutter). -->
        <TextView
                android:id="@+id/burst_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{timermodel.timerCount}"
                android:textColor="@color/settings_muted"
                android:textSize="11sp"
                android:fontFeatureSettings="tnum"
                android:translationY="16dp"
                android:visibility="@{timermodel.timerCount == null || timermodel.timerCount.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}"
                app:layout_constraintBottom_toBottomOf="@id/shutter_button_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:importantForAccessibility="no" />

        <FrameLayout
                android:id="@+id/camera_switch_container"
                android:layout_width="@dimen/vf_side_button_size"
                android:layout_height="@dimen/vf_side_button_size"
                android:layout_marginEnd="52dp"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toEndOf="@id/shutter_button_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/shutter_button_container"
                app:layout_constraintBottom_toBottomOf="@id/shutter_button_container">

            <ImageButton
                    android:layout_gravity="center"
                    android:id="@+id/flip_camera_button"
                    android:background="@drawable/shade_gallery_card"
                    android:clickable="true"
                    android:onClick="@{bottom_bar_click_listener}"
                    android:contentDescription="@string/shade_flip_camera"
                    android:tooltipText="@string/shade_flip_camera"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cv_flip"
                    android:padding="16dp"
                    android:visibility="visible"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"/>

        </FrameLayout>

        <!-- P574: the bottom row (the concept: 50dp squares with 16dp corners, the switch a 52dp capsule of two 44dp discs). -->
        <LinearLayout
                android:id="@+id/bottom_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                app:layout_constraintTop_toBottomOf="@id/shutter_button_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                    android:id="@+id/settings_button"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cv_gear"
                    android:contentDescription="@string/sheet_all_settings"
                    android:tooltipText="@string/sheet_all_settings"
                    android:onClick="@{bottom_bar_click_listener}"
                    bindRotate="@{uimodel}"/>

            <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

            <!-- Sport | Photo | Oldstyle (P630): the three modes as icons only, the chosen one on a lighter disc in the accent. -->
            <LinearLayout
                    android:id="@+id/mode_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="4dp"
                    android:importantForAccessibility="no">

                <ImageButton
                        android:id="@+id/mode_sport"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="10.5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cv_run_m"
                        android:onClick="@{bottom_bar_click_listener}"
                        bindRotate="@{uimodel}"/>

                <ImageButton
                        android:id="@+id/mode_photo"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="10.5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cv_photo_m"
                        android:onClick="@{bottom_bar_click_listener}"
                        bindRotate="@{uimodel}"/>

                <!-- P630: «Oldstyle», the third mode (OldstyleMode): the photo mode with the old tone, manual controls and adjustments -->
                <ImageButton
                        android:id="@+id/mode_oldstyle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="10.5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cv_os_cassette"
                        android:onClick="@{bottom_bar_click_listener}"
                        bindRotate="@{uimodel}"/>
            </LinearLayout>

            <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

            <FrameLayout
                    android:id="@+id/pro_button"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/bottom_pro"
                    bindRotate="@{uimodel}">

                <FrameLayout
                        android:id="@+id/pro_disc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:duplicateParentState="true">

                    <ImageView
                            android:id="@+id/pro_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/cv_sliders"
                            android:importantForAccessibility="no"/>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
