<?xml version="1.0" encoding="utf-8"?>
<!-- The text dialog of an EditTextPreference that keeps the preference library's dialog (BackupPreferences): P574 the dialog
     message and the app's text field (dialog_field), aligned with the title. Same ids as the library's
     preference_dialog_edittext. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <TextView
            android:fontFamily="@font/roboto_flex_400"
            app:fontFamily="@font/roboto_flex_400"
            android:id="@android:id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/dialog_body"
            android:textSize="15dp"
            android:lineSpacingExtra="3sp" />

        <EditText
            android:fontFamily="@font/roboto_flex_400"
            app:fontFamily="@font/roboto_flex_400"
            android:id="@android:id/edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/dialog_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/settings_row_title"
            android:textColorHint="@color/settings_section"
            android:textSize="16dp" />

    </LinearLayout>
</ScrollView>
