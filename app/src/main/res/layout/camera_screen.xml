<?xml version="1.0" encoding="utf-8"?>
<!-- The camera screen (CameraFragment). Two layers on a black root:
     camera_stage - everything that keeps the photo's geometry: the preview (camera_viewfinder), the 3:4 frame anchor the bottom bar
       hangs from, the Pro panel and its LUT / «Oldstyle» neighbours, the quick-settings sheet with its scrim and handle, the zoom
       readout and the message band. It starts under the top row, or at the top of a screen up to 16:9 (adjustCameraContainer).
     top_row and the pieces over it - the top row of 40dp items (camera_top_row), its grabber, the FULL sheet's scrim over the row
       and the recording readout. They stay out of camera_stage, so the stage's aspect handling never moves them. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="com.scamera.app.ui.camera.model.CameraFragmentModel"/>
        <variable name="uimodel" type="com.scamera.app.ui.camera.model.CameraFragmentModel"/>
        <variable name="auxmodel" type="com.scamera.app.ui.camera.model.AuxButtonsModel"/>
    </data>

    <com.scamera.app.ui.camera.CameraLayout
            android:id="@+id/camera_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:background="#FF000000">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/camera_stage"
                style="@style/Cam.Wide"
                android:layout_height="0dp"
                android:animateLayoutChanges="true"
                app:adjustCameraContainer="@{uimodel.screenAspectRatio}"
                app:layout_constraintTop_toBottomOf="@id/top_row"
                app:layout_constraintBottom_toBottomOf="parent">

            <!-- the preview with its overlays, from the stage's top -->
            <include
                    android:id="@+id/vf_layer"
                    layout="@layout/camera_viewfinder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintVertical_bias="0.0"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintBaseline_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            <!-- An invisible box of the photo's aspect (setAspectRatio, 3:4 by default) from the stage's top: the bottom bar
                 takes the room under it, whatever the preview's own shape. A FrameLayout on purpose: with no ratio yet it
                 measures 0 high under an AT_MOST spec, where a plain View would fill the stage and push the bar off screen. -->
            <FrameLayout
                    android:id="@+id/frame_anchor"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:setAspectRatio="@{uimodel.dummyAspectRatio}"
                    app:layout_constraintVertical_bias="0.0"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBaseline_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            <!-- The Pro panel (circularbarlib's manual_palette), 8dp in from the sides, 12dp over the bottom bar - that is over the
                 sheet's HIDDEN handle, which BottomChrome keeps it clear of when the handle floats over a 16:9 / video preview.
                 Sizes in dp / sp, so it follows the display and font size. Only while the sheet is HIDDEN: other levels fade and
                 slide it away, HIDDEN brings it back as it was (ExpandingManualPanel.setShadeShown). -->
            <include
                    android:id="@+id/pro_panel"
                    layout="@layout/manual_palette"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="12dp"
                    app:manualPanelShown="@{uimodel.sheetLevel == CameraFragmentModel.SHEET_HIDDEN}"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintVertical_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/bottom_bar"/>

            <!-- LutTray: the LUT and film tray, in the Pro panel's place (bottoms aligned); opening one closes the other. -->
            <LinearLayout
                    android:id="@+id/lut_tray"
                    style="@style/Cam.Wide.Inset"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/pro_panel"/>

            <!-- «Oldstyle» (P630c): the style's one-line HUD near the preview's top while its panel is open (OldstyleControls). -->
            <TextView
                    android:id="@+id/oldstyle_hud"
                    style="@style/Cam.Centred"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"/>

            <!-- «Oldstyle» (P630): the round style button and its panel (OldstyleControls) just over the Pro row, which that mode
                 keeps open; gone in the other modes. -->
            <FrameLayout
                    android:id="@+id/oldstyle_controls"
                    style="@style/Cam.Wide.Inset"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@id/pro_panel"/>

            <!-- The FULL sheet's dimming over the preview, under the sheet and over the preview's controls; shade_scrim_top does
                 the top row. CameraFragment.initSettingsBar sets its top margin to the row's height so the two never overlap. -->
            <View
                    android:id="@+id/shade_scrim"
                    style="@style/Cam.OverStage"
                    android:background="@color/shade_scrim"
                    android:elevation="10dp"
                    android:visibility="gone"/>

            <!-- The sheet's 28dp top edge with its grip while the sheet is HIDDEN (the sheet itself is off screen then), at the
                 bottom bar's top edge (P32, BottomChrome), so it never covers the preview. When the zoom ruler would reach it,
                 BottomChrome fades the slot (no touches) until the ruler goes. The slot stays VISIBLE and only the grip inside
                 toggles: the stage's layout transition would fade a newly shown slot in too late. -->
            <FrameLayout
                    android:id="@+id/settings_sheet_handle_slot"
                    style="@style/Cam.Wide"
                    android:layout_height="28dp"
                    app:layout_constraintTop_toTopOf="@id/bottom_bar">

                <ImageView
                        android:id="@+id/settings_sheet_handle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/sheet_handle_open"
                        android:scaleType="center"
                        android:src="@drawable/sheet_handle"
                        android:visibility="gone"/>
            </FrameLayout>

            <!-- the lens strip, the shutter row and the bottom row: the room under frame_anchor -->
            <include
                    android:id="@+id/bottom_bar"
                    layout="@layout/camera_bottom_bar"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:uimodel="@{uimodel}"
                    app:auxmodel="@{auxmodel}"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintTop_toBottomOf="@id/frame_anchor"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            <!-- The quick-settings sheet (HIDDEN / PEEK / FULL) over the preview; the coordinator gives it its behaviour. -->
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                    android:id="@+id/sheet_host"
                    style="@style/Cam.OverStage"
                    android:clickable="false"
                    android:elevation="@dimen/standard_20">

                <!-- 120dp is only a start: the tile grid measures the real peek height -->
                <com.scamera.app.ui.camera.views.settingsbar.SettingsBarLayout
                        android:id="@+id/settings_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        app:behavior_hideable="true"
                        app:behavior_peekHeight="120dp"
                        app:gestureInsetBottomIgnored="true"
                        app:layout_behavior="@string/bottom_sheet_behavior"
                        app:sheetLevel="@{uimodel.sheetLevel}"
                        app:iconRotation="@{uimodel.orientation}"/>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>

            <!-- the zoom readout (SIMPLE_UI §1), in the message band's place over the bar -->
            <com.scamera.app.ui.camera.views.ZoomReadoutView
                    android:id="@+id/zoom_readout"
                    style="@style/Cam.OverBar"
                    android:elevation="31dp"
                    android:visibility="gone"/>

            <!-- The message band (SIMPLE_UI §1): one 22dp line, 12sp, between the preview and the bar's first row; CameraFragment
                 puts it right over that row on every layout. -->
            <TextView
                    android:id="@+id/shade_toast"
                    style="@style/Cam.OverBar"
                    android:layout_height="22dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/message_band"
                    android:elevation="30dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/settings_text"
                    android:textSize="12sp"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone"
                    app:layout_constrainedWidth="true"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <include
                android:id="@+id/top_row"
                layout="@layout/camera_top_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:adjustTopBar="@{uimodel.screenAspectRatio}"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        <!-- The top grabber (P574): a tap or a pull down opens the «Верхняя строка» sheet (CameraFragment.attachTopGrabber); so does
             a swipe down from the top of the preview (Swipe.Router). -->
        <FrameLayout
                android:id="@+id/top_row_grabber"
                android:layout_width="56dp"
                android:layout_height="12dp"
                android:layout_marginTop="3dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/top_row_edit"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <View
                    android:id="@+id/top_row_grip"
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"/>
        </FrameLayout>

        <!-- the FULL sheet's dimming over the top row (outside camera_stage); see shade_scrim -->
        <View
                android:id="@+id/shade_scrim_top"
                style="@style/Cam.Wide"
                android:layout_height="0dp"
                android:background="@color/shade_scrim"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/top_row"/>

        <!-- the recording time, top right, monospaced on a dark plate -->
        <TextView
                android:id="@+id/video_recording_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp"
                android:background="#88000000"
                android:fontFamily="monospace"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
    </com.scamera.app.ui.camera.CameraLayout>
</layout>
