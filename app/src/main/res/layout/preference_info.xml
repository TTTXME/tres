<?xml version="1.0" encoding="utf-8"?>
<!-- P6b information row: the note of the module screen (i + text), no card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">
    <ImageView
        android:id="@+id/settings_info_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="14dp"
        android:importantForAccessibility="no"
        android:duplicateParentState="true"
        android:src="@drawable/cs_ic_info" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@android:id/title"
            android:fontFamily="@font/roboto_flex_500"
            app:fontFamily="@font/roboto_flex_500"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:textColor="@color/settings_text"
            android:textSize="14dp" />
        <TextView
            android:fontFamily="@font/roboto_flex_400"
            app:fontFamily="@font/roboto_flex_400"
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/settings_summary"
            android:lineHeight="17dp"
            android:includeFontPadding="false"
            android:textSize="13dp" />
    </LinearLayout>
</LinearLayout>
