<?xml version="1.0" encoding="utf-8"?>
<!-- P490 / P574: a row of the settings card (preference_card's icon tile, title and description) with its choice inline under it
     as a segmented control (IosSegmented: a capsule track, one thumb gliding to the chosen segment, the chosen label in the
     accent). SegmentedListPreference fills it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_row"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="9dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="34dp"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/settings_icon_tile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/settings_icon_tile">
            <ImageView
                android:id="@android:id/icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@android:id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/settings_row_title"
                android:textFontWeight="600"
                android:textSize="16sp" />
            <TextView
                android:id="@android:id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/settings_summary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <com.particlesdevs.photoncamera.ui.controls.IosSegmented
        android:id="@+id/choice_segments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />
</LinearLayout>
