<?xml version="1.0" encoding="utf-8"?>
<!-- P384 / P574: a row inside an open module card (ModuleSection): preference_card a step inward - in the inner #232325 block
     SettingsCardDecoration draws 10dp inside the card, 12dp in from the block's edge, a 30dp tile, the title 15sp semibold, the
     description 12.5sp and the value at 55 % white. Same ids as preference_card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_row"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingTop="8dp"
    android:paddingEnd="22dp"
    android:paddingBottom="8dp">
    <FrameLayout
        android:id="@+id/settings_icon_tile"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/settings_icon_tile_nested">
        <ImageView
            android:id="@android:id/icon"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_flex_600"
            app:fontFamily="@font/roboto_flex_600"
            android:textColor="@color/settings_row_title"
            android:textSize="15dp" />
        <TextView
            android:fontFamily="@font/roboto_flex_400"
            app:fontFamily="@font/roboto_flex_400"
            android:id="@+id/settings_value_below"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/settings_row_value"
            android:textSize="14dp"
            android:visibility="gone" />
        <TextView
            android:fontFamily="@font/roboto_flex_400"
            app:fontFamily="@font/roboto_flex_400"
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="1dp"
            android:textColor="@color/settings_row_value"
            android:textSize="12.5dp" />
        <TextView
            android:fontFamily="@font/roboto_flex_400"
            app:fontFamily="@font/roboto_flex_400"
            android:id="@+id/settings_restart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="7dp"
            android:paddingTop="1dp"
            android:paddingEnd="7dp"
            android:paddingBottom="1dp"
            android:textSize="11dp"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:fontFamily="@font/roboto_flex_400"
            app:fontFamily="@font/roboto_flex_400"
        android:id="@+id/settings_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="end"
        android:ellipsize="end"
        android:maxWidth="130dp"
        android:maxLines="1"
        android:textColor="@color/settings_row_value"
        android:textSize="15dp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minWidth="9dp"
        android:orientation="vertical"
        android:paddingStart="12dp" />
</LinearLayout>
