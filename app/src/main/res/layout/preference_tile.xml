<?xml version="1.0" encoding="utf-8"?>
<!-- P6b «Конфиг» tile: icon above the label; the three tiles share one row (SettingsStyle.TILES). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="@dimen/settings_card_gap"
    android:layout_marginEnd="4dp"
    android:background="@drawable/settings_card"
    android:gravity="center"
    android:minHeight="84dp"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="14dp"
    android:paddingEnd="6dp"
    android:paddingBottom="12dp">
    <ImageView
        android:id="@android:id/icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@android:id/title"
        android:fontFamily="@font/roboto_flex_500"
            app:fontFamily="@font/roboto_flex_500"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/settings_row_title"
        android:textSize="14dp" />
</LinearLayout>
